import { VerticalBox } from "std-widgets.slint";
import { ProposalRow } from "../types.slint";
import { MetadataDiffCard } from "../components/metadata-diff-row.slint";

export component ProposalView inherits Rectangle {
    in property <[ProposalRow]> proposal-rows;
    in property <bool> operable;
    in property <bool> wide;
    callback resolve-metadata(string,bool);
    min-height: content.preferred-height;
    min-width:0px;
    content := VerticalBox {
        padding:0px;spacing:12px;
        Text {text:"承認待ちの更新";font-size:18px;font-weight:600;wrap:word-wrap;}
        Text {text:"採用・維持の判断は、その項目について直ちに保存されます。正規版の切替と書誌項目の採用は別々に承認します。";wrap:word-wrap;}
        if root.proposal-rows.length==0 : Text {text:"承認待ちの更新はありません。";wrap:word-wrap;}
        for row in root.proposal-rows : MetadataDiffCard {
            proposal:row;operable:root.operable;wide:root.wide;
            resolve(id,accept)=>{root.resolve-metadata(id,accept);}
        }
    }
}
