import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit } from "std-widgets.slint";


export component ImportView inherits VerticalBox {
    in property <bool> about-open;
    in property <bool> busy;
    callback cancel-lookup();
    in property <bool> confirm-discard;
    callback confirm-lookup();
    callback fetch-lookup();
    in property <bool> load-required;
    in property <string> lookup-details;
    in-out property <bool> lookup-dirty;
    in-out property <bool> lookup-has-result;
    in-out property <string> lookup-identifier;
    in-out property <string> lookup-key;
    in property <bool> lookup-new;
    in property <bool> ready;
    Text {text:root.lookup-new ? "識別子から文献を登録" : "識別子から更新候補を取得";font-size:20px;}
    Text {text:"DOI は Crossref、arXiv ID は arXiv へ送信します。取得結果を確認するまで保存しません。";wrap:word-wrap;}
    LineEdit {accessible-label:"取得する識別子";enabled:root.ready && !root.busy && !root.confirm-discard && !root.about-open;text<=>root.lookup-identifier;placeholder-text:"DOI / arXiv ID または公式URL";edited(v)=>{root.lookup-dirty=true;root.lookup-has-result=false;}}
    Button {text:"書誌情報を取得";enabled:root.ready && !root.busy && !root.confirm-discard && !root.about-open && !root.load-required;clicked=>{root.fetch-lookup();}}
    if root.lookup-new && root.lookup-has-result : VerticalBox {
        Text {text:"引用キー（第一著者＋出版年。使用済みならタイトル代表語を追加）";wrap:word-wrap;}
        LineEdit {enabled:!root.busy && !root.about-open && !root.confirm-discard;text<=>root.lookup-key;edited(v)=>{root.lookup-dirty=true;}}
    }
    TextEdit {text:root.lookup-details;read-only:true;vertical-stretch:1;}
    if !root.lookup-new : Text {text:"保存すると既存の候補・承認処理へ渡します。手動値は承認するまで保持します。";wrap:word-wrap;}
    HorizontalBox {
        Button {text:root.lookup-new ? "この内容で登録" : "更新候補として保存";enabled:root.ready && !root.busy && !root.confirm-discard && !root.about-open && !root.load-required && root.lookup-has-result;clicked=>{root.confirm-lookup();}}
        Button {text:"入力と取得結果を破棄して戻る";enabled:!root.busy && !root.about-open && !root.confirm-discard;clicked=>{root.cancel-lookup();}}
    }
}
