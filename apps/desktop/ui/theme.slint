export global Theme {
    // Backgrounds
    out property <color> background: #f4f6fa;
    out property <color> sidebar: #eaf0f8;
    out property <color> list-background: #f8faff;
    out property <color> surface: #ffffff;

    // Text colors
    out property <color> text-primary: #20314f;
    out property <color> text-secondary: #66758b;
    out property <color> text-muted: #536783;

    // Borders
    out property <color> border: #e1e7ef;
    out property <color> divider: #d6dfed;

    // Selection
    out property <color> selection: #e6efff;
    out property <color> selection-border: #6e95da;

    // Warning
    out property <color> warning: #945616;

    // Modal overlay
    out property <color> overlay: #00000066;
}