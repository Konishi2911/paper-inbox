export enum DiffInputField { value, doi, arxiv }
export enum DiffResolution { unresolved, keep-current, accept-proposed, custom }
export enum DiffFilter { all, changed, conflict, unresolved, decided }
export enum DiffBulkAction { accept-safe, keep-all, reset }

export enum AuthorAction {
    add,
    remove,
    move-up,
    move-down,
}

export enum NavigationAction {
    create-paper,
    open-paper,
    reconnect,
    quit,
    metadata-review,
    import-paper,
    attachment-cleanup,
}

export struct AuthorRow { kind:int, given:string, name:string, orcid:string }

export struct PaperRow { selected:bool, id:string, title:string, authors:string, year:string, citation-key:string }

export struct AttachmentRow { id:string, name:string, details:string, missing:bool }

export struct LookupField { label:string, value:string }

export struct CandidateRow { id:string, label:string, details:string, held:bool }
export struct ProposalRow { id:string, label:string, current:string, proposed:string, reason:string, source:string, stale:bool, change-label:string, conflict:bool, current-source:string, current-details:string, proposed-details:string, text-diff:string, structured-diff:string, decision:DiffResolution, custom-text:string, custom-doi:string, custom-arxiv:string, custom-kind:int, bulk-safe:bool, long-text:bool, current-preview:string, proposed-preview:string }
export struct VersionRow { id:string, label:string, details:string, canonical:bool }

export enum DetailView {
    empty,
    paper-detail,
    paper-editor,
    import,
    metadata-review,
    metadata-candidate-editor,
    export-settings,
    export-preview,
    attachment-cleanup,
}

// External links opened from the detail; URLs are built and validated in Rust.
export enum LinkTarget { doi, arxiv, url }
