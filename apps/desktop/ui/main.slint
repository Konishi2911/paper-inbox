import { ConfirmDialog } from "dialogs/confirm-dialog.slint";
import { MetadataView } from "views/metadata-view.slint";
import { ExportDialog } from "dialogs/export-dialog.slint";
import { ImportView } from "views/import-view.slint";
import { ExportView } from "views/export-view.slint";
import { CleanupView } from "views/cleanup-view.slint";
import { AboutDialog } from "dialogs/about-dialog.slint";
import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PaperList } from "components/paper-list.slint";
import { Sidebar } from "components/sidebar.slint";
import { Splitter } from "components/splitter.slint";
import { PaperDetail } from "components/paper-detail.slint";
import { PaperEditor } from "components/paper-editor.slint";
import { AttachmentRow, TagRow, DiffInputField, DiffResolution, DiffFilter, DiffBulkAction, DetailView, AuthorAction, NavigationAction, AuthorRow, PaperRow, LookupField, LinkTarget, CandidateRow, ProposalRow, VersionRow } from "types.slint";

export { AttachmentRow, TagRow, DiffInputField, DiffResolution, DiffFilter, DiffBulkAction, DetailView, AuthorAction, NavigationAction, AuthorRow, PaperRow, LookupField, LinkTarget, CandidateRow, ProposalRow, VersionRow } from "types.slint";

export component MainWindow inherits Window {
    title:"Paper Inbox";
    preferred-width:1360px;
    preferred-height:900px;
    min-width:1080px;
    min-height:680px;
    background:Theme.background;
    default-font-size:14px;
    in-out property <DetailView> detail-view:DetailView.empty;
    // Return targets retain navigation history; only detail-view selects a screen.
    in-out property <DetailView> export-return-view:DetailView.empty;
    in-out property <DetailView> preview-return-view:DetailView.empty;
    in-out property <bool> about-open:false;
    in-out property <bool> sidebar-collapsed:false;
    out property <bool> export-settings-open: root.detail-view==DetailView.export-settings;
    out property <bool> cleanup-open: root.detail-view==DetailView.attachment-cleanup;
    // PDFs of the paper on screen and the unused-file summary, both set by Rust.
    in-out property <[AttachmentRow]> attachment-rows;
    in-out property <string> primary-attachment;
    in-out property <[TagRow]> tag-rows;
    in-out property <[TagRow]> paper-tag-rows;
    in-out property <[TagRow]> tag-suggestions;
    in-out property <[string]> filter-tag-ids;
    callback add-tag(string);
    callback remove-tag(string);
    callback tag-input-changed(string);
    callback toggle-tag-filter(string);
    in-out property <string> identifiers-line;
    in-out property <int> cleanup-count:0;
    in-out property <string> cleanup-size;
    callback attach-pdf();
    callback open-attachment(string);
    callback detach-attachment(string);
    callback reclaim-unused();

    out property <bool> lookup-open: root.detail-view==DetailView.import;
    in-out property <bool> lookup-new:false;
    in-out property <bool> lookup-dirty:false;
    in-out property <bool> lookup-has-result:false;
    in-out property <string> lookup-identifier;
    in-out property <string> lookup-key;
    // Fetched values are read-only; personal values are registered with them.
    in-out property <string> lookup-source;
    in-out property <[LookupField]> lookup-fields;
    in-out property <string> lookup-notes;
    in-out property <int> lookup-reading-status:0;
    in-out property <bool> lookup-favorite:false;
    callback begin-lookup();
    callback fetch-lookup();
    callback confirm-lookup();
    callback cancel-lookup();
    callback suggest-key();

    in-out property <bool> busy:true;
    in-out property <bool> ready:false;
    in-out property <string> status:"保存先を開いています…";
    in-out property <string> database-path;
    in-out property <[PaperRow]> papers;
    in-out property <[AuthorRow]> author-rows;
    in-out property <string> search-text;
    in-out property <bool> show-deleted:false;
    in-out property <bool> include-archived:false;
    in-out property <bool> filter-unread:false;
    in-out property <bool> filter-favorite:false;
    in-out property <bool> filter-pdf:false;
    in-out property <int> sort-index:0;
    in-out property <int> limit:50;
    in-out property <int> total:0;
    in-out property <string> citation-key;
    in-out property <string> paper-title;
    in-out property <string> container-title;
    in-out property <string> year;
    in-out property <string> doi;
    in-out property <string> arxiv-id;
    in-out property <string> identifier-warning;
    in-out property <[string]> selected-ids;
    in-out property <int> selected-count:0;
    in-out property <string> export-path;
    in-out property <bool> export-abstract:false;
    in-out property <bool> export-doi:true;
    in-out property <bool> export-url:true;
    in-out property <bool> export-keywords:false;
    out property <bool> export-confirm: root.detail-view==DetailView.export-preview;
    in-out property <bool> export-replaces:false;
    in-out property <string> export-preview;
    in-out property <string> export-summary;
    in-out property <string> export-warnings;
    in-out property <int> publication-type:0;
    in-out property <string> notes;
    in-out property <int> reading-status:0;
    in-out property <bool> favorite:false;
    in-out property <bool> archived:false;
    in-out property <bool> dirty:false;
    out property <bool> editor-visible: root.detail-view==DetailView.paper-detail || root.detail-view==DetailView.paper-editor;
    in-out property <bool> editor-deleted:false;
    in-out property <bool> saved-paper:false;
    in-out property <bool> load-required:false;
    in-out property <string> editing-id;

    out property <bool> edit-mode: root.detail-view==DetailView.paper-editor && !root.editor-deleted;
    in-out property <string> paper-authors;

    // Bibliography fields shared by the detail and the form.
    in-out property <string> publisher;
    in-out property <string> volume;
    in-out property <string> issue;
    in-out property <string> pages;
    in-out property <string> url;
    in-out property <string> abstract-text;
    in-out property <string> keywords;
    // Read-only presentation computed by Rust from the saved paper.
    in-out property <string> paper-authors-short;
    in-out property <string> publication-summary;
    in-out property <string> abstract-preview;
    in-out property <bool> abstract-long:false;
    in-out property <string> keywords-line;
    in-out property <string> paper-bibtex;
    // Inline note editing in the detail; reset by Rust after a successful reload.
    in-out property <bool> notes-editing:false;
    callback change-reading-status(int);
    callback toggle-favorite();
    callback toggle-archived();
    callback save-notes();
    callback open-link(LinkTarget);

    out property <bool> metadata-open: root.detail-view==DetailView.metadata-review || root.detail-view==DetailView.metadata-candidate-editor;
    out property <bool> candidate-form-open: root.detail-view==DetailView.metadata-candidate-editor;
    in-out property <bool> review-dirty:false;
    in-out property <DiffFilter> diff-filter:DiffFilter.changed;
    in-out property <[ProposalRow]> filtered-proposal-rows:root.proposal-rows;
    callback refilter-metadata();
    changed diff-filter => {root.refilter-metadata();}
    in-out property <string> diff-summary;
    callback choose-metadata(string,DiffResolution);
    callback edit-metadata(string,DiffInputField,string);
    callback bulk-metadata(DiffBulkAction);
    callback apply-metadata();
    in-out property <bool> candidate-dirty:false;
    in-out property <string> review-label;
    in-out property <[CandidateRow]> candidate-rows;
    in-out property <[ProposalRow]> proposal-rows;
    in-out property <[VersionRow]> version-rows;
    in-out property <bool> associate-confirm:false;
    in-out property <string> associate-id;

    in-out property <string> candidate-id;
    in-out property <string> candidate-observed;
    in-out property <int> candidate-source:0;
    in-out property <int> candidate-kind:0;
    in-out property <string> candidate-source-name;
    in-out property <string> candidate-record;
    in-out property <string> candidate-updated;
    in-out property <string> candidate-doi;
    in-out property <string> candidate-arxiv;
    in-out property <string> candidate-title;
    in-out property <string> candidate-year;
    in-out property <string> candidate-container;
    in-out property <string> candidate-publisher;
    in-out property <string> candidate-abstract;
    in-out property <bool> candidate-use-title:false;
    in-out property <bool> candidate-use-year:false;
    in-out property <bool> candidate-use-container:false;
    in-out property <bool> candidate-use-publisher:false;
    in-out property <bool> candidate-use-abstract:false;

    // Pane layout
    in-out property <length> paper-list-width: 380px;

    property <length> sidebar-width:
        root.sidebar-collapsed ? 64px : 208px;

    property <length> paper-list-min-width: 260px;
    property <length> paper-detail-min-width: 360px;

    callback begin-candidate();
    callback submit-candidate();
    callback associate-candidate(string);
    callback resolve-metadata(string,bool);
    callback propose-canonical(string);

    property <bool> operable:
        root.ready
        && !root.busy
        && !root.confirm-discard
        && !root.confirm-delete
        && !root.about-open
        && !root.export-confirm;
    property <bool> delete-confirm-operable:
        root.ready
        && !root.busy
        && root.confirm-delete
        && !root.confirm-discard
        && !root.about-open
        && !root.export-confirm
        && !root.load-required;
    property <bool> metadata-operable:
        root.operable
        && !root.load-required;
    property <bool> editable:
        root.operable
        && !root.editor-deleted
        && !root.load-required;

    in-out property <bool> confirm-discard:false;
    in-out property <bool> confirm-delete:false;
    property <NavigationAction> pending-action;
    property <string> pending-id;
    callback select-paper(string,bool);
    callback prepare-export();
    callback confirm-export();
    callback cancel-export();
    callback search();
    callback navigate(NavigationAction,string);
    callback save();
    callback delete-paper(bool);
    callback author-edit(int,int,string);
    callback author-kind(int,int);
    callback author-action(AuthorAction,int);
    callback author-bulk(string);
    // Save or validation error shown beside the form actions.
    in-out property <string> form-error;
    public function request-navigation(action:NavigationAction,id:string) {
        if (
            root.dirty
            || root.review-dirty
            || root.candidate-dirty
            || root.lookup-dirty
        ) {
            root.pending-action=action;
            root.pending-id=id;
            root.confirm-discard=true;
        }
        else {
            root.navigate(action,id);
        }
    }
    public function close-export() {
        root.detail-view=root.export-return-view;
    }
    public function toggle-export() {
        if (root.detail-view==DetailView.export-settings) {
            root.close-export();
        } else {
            root.export-return-view=root.detail-view;
            root.detail-view=DetailView.export-settings;
        }
    }
    public function open-paper(id:string) {
        if (
            root.operable
            && !(
                root.editing-id==id
                && !root.metadata-open
                && !root.lookup-open
                && !root.export-settings-open
                && !root.cleanup-open
        )) {
            root.request-navigation(NavigationAction.open-paper,id);
        }
    }
    VerticalBox {
        padding:0px; spacing:0px;
        HorizontalBox {
            padding:14px;spacing:12px;
            Button {enabled:!root.about-open;accessible-label:root.sidebar-collapsed ? "メニューを展開" : "メニューを折りたたむ";text:root.sidebar-collapsed ? "☰" : "‹";width:38px;clicked=>{root.sidebar-collapsed=!root.sidebar-collapsed;}}
            Text {text:"Paper Inbox";font-size:22px;font-weight:700;color:Theme.text-primary;}
            Text {text:root.busy ? "処理中…" : "文献ライブラリ";horizontal-alignment:right;color:Theme.text-secondary;}
        }
        HorizontalBox {
            spacing:0px;vertical-stretch:1;
            Sidebar {
                width: root.sidebar-width;

                collapsed: root.sidebar-collapsed;
                operable: root.operable;

                selected-count: root.selected-count;
                database-path: root.database-path;

                can-open-about: !root.about-open
                    && !root.confirm-discard
                    && !root.confirm-delete
                    && !root.export-confirm;

                can-reconnect: !root.busy
                    && !root.about-open
                    && !root.confirm-discard
                    && !root.confirm-delete
                    && !root.export-confirm;

                add-requested => {root.request-navigation(NavigationAction.import-paper,"");}

                library-requested(deleted) => {
                    root.show-deleted = deleted;
                    root.filter-tag-ids = [];
                    root.search-text = "";
                    root.limit = 50;
                    root.search();
                }

                export-requested => { root.toggle-export(); }
                cleanup-requested => { root.request-navigation(NavigationAction.attachment-cleanup,""); }
                tag-rows: root.tag-rows;
                tag-toggled(id) => { root.toggle-tag-filter(id); }
                about-requested => { root.about-open = true; }
                reconnect-requested => { root.request-navigation(NavigationAction.reconnect,""); }
            }
            paper-list := PaperList {
                preferred-width: root.paper-list-width;
                min-width: root.paper-list-min-width;
                horizontal-stretch: 0;
                editing-id : root.editing-id;
                export-settings-open : root.export-settings-open || (root.detail-view==DetailView.export-preview && root.preview-return-view==DetailView.export-settings);
                include-archived <=> root.include-archived;
                filter-unread <=> root.filter-unread;
                filter-favorite <=> root.filter-favorite;
                filter-pdf <=> root.filter-pdf;
                limit <=> root.limit;
                load-more()=>{root.limit += 50; root.search();}
                opened(arg0)=>{root.open-paper(arg0);}
                operable : root.operable;
                papers : root.papers;
                search()=>{root.search();}
                search-text <=> root.search-text;
                select-paper(arg0,arg1)=>{root.select-paper(arg0,arg1);}
                show-deleted : root.show-deleted;
                sort-index <=> root.sort-index;
                total : root.total;
            }
            Splitter {
                target-width: paper-list.width;
                operable: root.operable;

                resize-requested(new-width) => {
                    root.paper-list-width = clamp(
                        new-width,
                        root.paper-list-min-width,
                        root.width - root.sidebar-width - root.paper-detail-min-width - 8px
                    );
                }
            }
            Rectangle {
                horizontal-stretch:1;
                min-width:root.paper-detail-min-width;

                background:Theme.surface;
                VerticalBox {
                    padding:20px;spacing:12px;
                    if root.confirm-discard : ConfirmDialog {
                        message:"未保存の入力があります。破棄して移動しますか？";
                        accept-label:"破棄して移動";cancel-label:"編集を続ける";warning:true;
                        operable:!root.busy && !root.about-open;
                        accepted=>{root.confirm-discard=false;root.navigate(root.pending-action,root.pending-id);}
                        cancelled=>{root.confirm-discard=false;}
                    }
                    if root.detail-view==DetailView.export-settings : ExportView {
                        export-abstract <=> root.export-abstract;
                        export-doi <=> root.export-doi;
                        export-keywords <=> root.export-keywords;
                        export-path <=> root.export-path;
                        export-url <=> root.export-url;
                        operable : root.operable;
                        prepare-export()=>{root.prepare-export();}
                        return-requested()=>{root.close-export();}
                        selected-count : root.selected-count;
                    }
                    if root.detail-view==DetailView.attachment-cleanup : CleanupView {
                        count : root.cleanup-count;
                        size : root.cleanup-size;
                        operable : root.operable;
                        reclaim-requested()=>{root.reclaim-unused();}
                        close-requested()=>{
                            if (root.editing-id=="") {
                                root.detail-view=DetailView.empty;
                            } else {
                                root.request-navigation(NavigationAction.open-paper,root.editing-id);
                            }
                        }
                    }
                    if root.detail-view==DetailView.import : ImportView {
                        about-open : root.about-open;
                        busy : root.busy;
                        cancel-lookup()=>{root.cancel-lookup();}
                        confirm-discard : root.confirm-discard;
                        confirm-lookup()=>{root.confirm-lookup();}
                        fetch-lookup()=>{root.fetch-lookup();}
                        load-required : root.load-required;
                        lookup-source : root.lookup-source;
                        lookup-fields : root.lookup-fields;
                        lookup-dirty <=> root.lookup-dirty;
                        lookup-has-result <=> root.lookup-has-result;
                        lookup-identifier <=> root.lookup-identifier;
                        lookup-key <=> root.lookup-key;
                        lookup-notes <=> root.lookup-notes;
                        lookup-reading-status <=> root.lookup-reading-status;
                        lookup-favorite <=> root.lookup-favorite;
                        lookup-new : root.lookup-new;
                        ready : root.ready;
                        manual-requested => {root.request-navigation(NavigationAction.create-paper,"");}
                    }
                    if root.detail-view==DetailView.export-preview : ExportDialog {
                        about-open : root.about-open;
                        busy : root.busy;
                        cancel-export()=>{root.cancel-export();}
                        confirm-export()=>{root.confirm-export();}
                        export-preview : root.export-preview;
                        export-replaces : root.export-replaces;
                        export-summary : root.export-summary;
                        export-warnings : root.export-warnings;
                    }

                    if root.detail-view==DetailView.metadata-review || root.detail-view==DetailView.metadata-candidate-editor : MetadataView {
                        about-open : root.about-open;
                        associate-candidate(arg0)=>{root.associate-candidate(arg0);}
                        associate-confirm : root.associate-confirm;
                        associate-id : root.associate-id;
                        begin-candidate()=>{root.begin-candidate();}
                        begin-lookup()=>{root.begin-lookup();}
                        busy : root.busy;
                        cancel-association()=>{root.associate-confirm=false;}
                        cancel-candidate()=>{root.candidate-dirty=false;root.detail-view=DetailView.metadata-review;}
                        candidate-abstract <=> root.candidate-abstract;
                        candidate-arxiv <=> root.candidate-arxiv;
                        candidate-container <=> root.candidate-container;
                        candidate-dirty <=> root.candidate-dirty;
                        candidate-doi <=> root.candidate-doi;
                        candidate-form-open : root.candidate-form-open;
                        candidate-kind <=> root.candidate-kind;
                        candidate-publisher <=> root.candidate-publisher;
                        candidate-record <=> root.candidate-record;
                        candidate-rows : root.candidate-rows;
                        candidate-source <=> root.candidate-source;
                        candidate-source-name <=> root.candidate-source-name;
                        candidate-title <=> root.candidate-title;
                        candidate-updated <=> root.candidate-updated;
                        candidate-use-abstract <=> root.candidate-use-abstract;
                        candidate-use-container <=> root.candidate-use-container;
                        candidate-use-publisher <=> root.candidate-use-publisher;
                        candidate-use-title <=> root.candidate-use-title;
                        candidate-use-year <=> root.candidate-use-year;
                        candidate-year <=> root.candidate-year;
                        confirm-discard : root.confirm-discard;
                        metadata-operable : root.metadata-operable;
                        proposal-rows : root.filtered-proposal-rows;
                        proposal-total : root.proposal-rows.length;
                        propose-canonical(arg0)=>{root.propose-canonical(arg0);}
                        review-dirty:root.review-dirty;
                        diff-filter <=> root.diff-filter;
                        diff-summary:root.diff-summary;
                        choose-metadata(id,decision)=>{root.choose-metadata(id,decision);}
                        edit-metadata(id,field,value)=>{root.edit-metadata(id,field,value);}
                        bulk-metadata(action)=>{root.bulk-metadata(action);}
                        apply-metadata()=>{root.apply-metadata();}
                        refresh-review()=>{root.request-navigation(NavigationAction.metadata-review,root.editing-id);}
                        request-association(arg0)=>{root.associate-id=arg0;root.associate-confirm=true;}
                        resolve-metadata(arg0,arg1)=>{root.resolve-metadata(arg0,arg1);}
                        return-to-paper()=>{root.request-navigation(NavigationAction.open-paper,root.editing-id);}
                        review-label : root.review-label;
                        submit-candidate()=>{root.submit-candidate();}
                        version-rows : root.version-rows;
                    }
                    if root.detail-view==DetailView.empty || root.detail-view==DetailView.paper-detail || root.detail-view==DetailView.paper-editor : VerticalBox {
                        if root.detail-view==DetailView.empty : Text { text:"中央の一覧から文献を選択してください。新しい文献は左の「文献を追加」から登録できます。";wrap:word-wrap;color:Theme.text-secondary; }
                        if root.detail-view==DetailView.paper-detail : PaperDetail {
                            vertical-stretch:1;

                            title: root.paper-title;
                            authors: root.paper-authors;
                            authors-short: root.paper-authors-short;
                            publication-summary: root.publication-summary;
                            doi: root.doi;
                            arxiv-id: root.arxiv-id;
                            url: root.url;
                            citation-key: root.citation-key;
                            bibtex: root.paper-bibtex;
                            abstract-text: root.abstract-text;
                            abstract-preview: root.abstract-preview;
                            abstract-long: root.abstract-long;
                            keywords-line: root.keywords-line;
                            notes <=> root.notes;
                            notes-editing <=> root.notes-editing;
                            dirty <=> root.dirty;
                            favorite: root.favorite;
                            archived: root.archived;
                            reading-status <=> root.reading-status;

                            operable: root.operable;
                            editable: root.editable;
                            identifier-warning: root.identifier-warning;

                            edit-requested => {
                                root.detail-view=DetailView.paper-editor;
                            }
                            metadata-requested => {
                                root.request-navigation(NavigationAction.metadata-review, root.editing-id);
                            }
                            reading-status-selected(index) => { root.change-reading-status(index); }
                            favorite-toggled => { root.toggle-favorite(); }
                            archive-toggled => { root.toggle-archived(); }
                            notes-save-requested => { root.save-notes(); }
                            // Discarding a note draft reloads the saved paper through the usual confirmation.
                            notes-cancel-requested => {
                                if (root.dirty) {
                                    root.request-navigation(NavigationAction.open-paper, root.editing-id);
                                } else {
                                    root.notes-editing = false;
                                }
                            }
                            link-requested(target) => { root.open-link(target); }
                            attachment-rows: root.attachment-rows;
                            primary-attachment: root.primary-attachment;
                            identifiers-line: root.identifiers-line;
                            tag-rows: root.paper-tag-rows;
                            tag-suggestions: root.tag-suggestions;
                            tag-add-requested(name) => { root.add-tag(name); }
                            tag-remove-requested(id) => { root.remove-tag(id); }
                            tag-input-changed(text) => { root.tag-input-changed(text); }
                            copied(what) => { root.status = what + "をコピーしました。"; }
                            attach-requested => { root.attach-pdf(); }
                            attachment-open-requested(id) => { root.open-attachment(id); }
                            attachment-detach-requested(id) => { root.detach-attachment(id); }
                        }
                        if root.detail-view==DetailView.paper-editor : PaperEditor {
                            citation-key <=> root.citation-key;
                            paper-title <=> root.paper-title;
                            container-title <=> root.container-title;
                            year <=> root.year;
                            doi <=> root.doi;
                            arxiv-id <=> root.arxiv-id;
                            publisher <=> root.publisher;
                            volume <=> root.volume;
                            issue <=> root.issue;
                            pages <=> root.pages;
                            url <=> root.url;
                            abstract-text <=> root.abstract-text;
                            keywords <=> root.keywords;
                            form-error: root.form-error;
                            notes <=> root.notes;
                            publication-type <=> root.publication-type;
                            reading-status <=> root.reading-status;
                            favorite <=> root.favorite;
                            archived <=> root.archived;
                            dirty <=> root.dirty;
                            author-rows: root.author-rows;
                            identifier-warning: root.identifier-warning;
                            operable: root.operable;
                            editable: root.editable;
                            saved-paper: root.saved-paper;
                            editor-deleted: root.editor-deleted;
                            load-required: root.load-required;
                            edit-mode: root.edit-mode;
                            confirm-delete: root.confirm-delete;
                            delete-confirm-operable: root.delete-confirm-operable;
                            save => {root.save();}
                            suggest-key => {root.suggest-key();}
                            lookup-requested => {root.request-navigation(NavigationAction.import-paper,"");}
                            reload-requested => {root.request-navigation(NavigationAction.open-paper,root.editing-id);}
                            metadata-requested => {root.request-navigation(NavigationAction.metadata-review,root.editing-id);}
                            cancel-requested => {
                                if (root.dirty || root.load-required) {
                                    root.request-navigation(NavigationAction.open-paper,root.editing-id);
                                } else {
                                    root.detail-view=DetailView.paper-detail;
                                }
                            }
                            delete-requested => {root.confirm-delete=true;}
                            restore-requested => {root.delete-paper(false);}
                            confirm-delete-requested => {root.confirm-delete=false;root.delete-paper(true);}
                            cancel-delete-requested => {root.confirm-delete=false;}
                            author-edit(index,field,value) => {root.author-edit(index,field,value);}
                            author-kind(index,kind) => {root.author-kind(index,kind);}
                            author-action(action,index) => {root.author-action(action,index);}
                            author-bulk(text) => {root.author-bulk(text);}
                        }

                    }
                }
            }
        }
        Rectangle {height:1px;background:Theme.border;}
        HorizontalBox {
            padding:10px;
            Text {text:root.status;wrap:word-wrap;color:Theme.text-muted;}
        }
    }
    if root.about-open : Rectangle {
        x:0px;y:0px;width:parent.width;height:parent.height;background:Theme.overlay;
        TouchArea {}
        AboutDialog {
            x:(parent.width - self.width) / 2;
            y:(parent.height - self.height) / 2;
            close=>{root.about-open=false;}
        }
    }

}
