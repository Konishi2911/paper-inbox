import {
    VerticalBox,
    HorizontalBox,
    CheckBox
} from "std-widgets.slint";

import { Theme } from "../theme.slint";

export component PaperCard inherits Rectangle {
    // Input properties
    in property <string> title;
    in property <string> authors;
    in property <string> year;
    in property <string> citation-key;
    in property <int> reading-status: 2;
    in property <bool> favorite: false;
    in property <bool> has-pdf: false;

    in property <bool> active: false;
    in property <bool> selected: false;
    in property <bool> operable: true;
    in property <bool> export-mode: false;

    // Callbacks
    callback opened();
    // A click made with Ctrl (Cmd on macOS) and/or Shift held: it selects instead of opening.
    callback modified-click(bool, bool);
    callback selection-changed(bool);

    // Modifier keys as they were when the button went down; `clicked` does not carry them.
    private property <bool> ctrl-down: false;
    private property <bool> shift-down: false;

    // Appearance
    border-radius: 4px;
    border-width: 1px;

    border-color: (root.active || root.selected)
        ? Theme.selection-border
        : Theme.border;

    background: (root.active || root.selected)
        ? Theme.selection
        : (root.operable && card-touch.has-hover
            ? Theme.hover
            : Theme.surface
        );

    animate background, border-color {
        duration: 100ms;
        easing: ease-out;
    }

    preferred-height: root.export-mode ? 126px : 90px;

    // Content
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        Rectangle {

            VerticalBox {
                padding: 8px;
                spacing: 3px;

                Text {
                    text: root.title == ""
                        ? "（タイトルなし）"
                        : root.title;

                    // At most two lines in a fixed height. A height that follows the wrapped
                    // text is not seen by the ScrollView, which then cannot reach the last cards.
                    wrap: word-wrap;
                    overflow: elide;
                    height: 38px;
                    vertical-alignment: top;
                    font-weight: 600;
                    color: Theme.text-primary;
                }

                Text {
                    text: root.authors;
                    overflow: elide;
                    color: Theme.text-secondary;
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.year + "  ·  " + root.citation-key;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: elide;
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }
                    // State at a glance: reading status, favorite and PDF.
                    if root.reading-status == 0 : Text {
                        text: "未読";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.selection-border;
                    }
                    if root.reading-status == 1 : Text {
                        text: "読書中";
                        font-size: 12px;
                        color: Theme.selection-border;
                    }
                    if root.favorite : Text {
                        text: "★";
                        font-size: 12px;
                        color: Theme.warning;
                    }
                    if root.has-pdf : Text {
                        text: "PDF";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                    // A mark besides the color, so a selection is not told by color alone.
                    if root.selected : Text {
                        text: "✓ 選択中";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.selection-border;
                    }
                }
            }

            card-touch := TouchArea {
                enabled: root.operable;
                mouse-cursor: pointer;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.ctrl-down = event.modifiers.control || event.modifiers.meta;
                        root.shift-down = event.modifiers.shift;
                    }
                }

                clicked => {
                    if (root.ctrl-down || root.shift-down) {
                        root.modified-click(root.ctrl-down, root.shift-down);
                    } else {
                        root.opened();
                    }
                }
            }
        }

        if root.export-mode : HorizontalBox {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 4px;

            CheckBox {
                enabled: root.operable;
                text: "BibTeX 出力に含める";
                checked: root.selected;

                toggled => {
                    root.selection-changed(self.checked);
                }
            }
        }
    }

    // Accessibility
    accessible-role: button;

    accessible-label: "文献を開く: "
        + (root.title == ""
            ? root.citation-key
            : root.title);

    accessible-enabled: root.operable;

    accessible-action-default => {
        root.opened();
    }
}