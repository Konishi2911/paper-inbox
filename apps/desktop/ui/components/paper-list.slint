import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";
import { PaperCard } from "paper-card.slint";
import { Theme } from "../theme.slint";
import { PaperRow } from "../types.slint";

export component PaperList inherits Rectangle {
    in property <string> editing-id;
    in property <bool> export-settings-open;
    in-out property <bool> include-archived;
    in-out property <bool> filter-unread;
    in-out property <bool> filter-favorite;
    in-out property <bool> filter-pdf;
    in-out property <int> limit: 50;
    callback load-more();
    callback opened(string);
    in property <bool> operable;
    in property <[PaperRow]> papers;
    callback search();
    in-out property <string> search-text;
    callback select-paper(string,bool);
    in property <bool> show-deleted;
    in-out property <int> sort-index;
    in property <int> total;

    pure function more-wanted() -> bool {
        return root.operable && root.papers.length < root.total && root.papers.length >= root.limit
            && scroll.content-y + scroll.content-height - scroll.height < 120px;
    }
    function maybe-load-more() {
        if (root.more-wanted()) { root.load-more(); }
    }

    // Typing searches by itself shortly after the last keystroke; Enter and the button search at once.
    typing := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.limit = 50;
            root.search();
        }
    }

    background: Theme.list-background;
    VerticalBox {
        padding:16px;spacing:10px;
        HorizontalBox {
            padding:0px;spacing:8px;
            Text {text:root.show-deleted ? "削除済み" : "すべての文献";font-size:20px;font-weight:700;color:Theme.text-primary;vertical-alignment:center;}
            Text {text:root.total==root.papers.length ? root.total+"件" : root.papers.length+" / "+root.total+"件";color:Theme.text-secondary;vertical-alignment:center;}
        }
        HorizontalBox {
            LineEdit {accessible-label:"文献を検索";text<=>root.search-text;placeholder-text:"タイトル・著者・引用キーを検索";accepted=>{typing.running=false;root.limit=50;root.search();} edited=>{typing.running=false;typing.running=true;}}
            Button {enabled:root.operable;text:"検索";clicked=>{root.limit=50;root.search();}}
        }
        HorizontalBox {
            padding:0px;spacing:6px;
            Button {accessible-label:"未読だけ表示";text:"未読";primary:root.filter-unread;enabled:root.operable;clicked=>{root.filter-unread=!root.filter-unread;root.limit=50;root.search();}}
            Button {accessible-label:"お気に入りだけ表示";text:"★";primary:root.filter-favorite;enabled:root.operable;clicked=>{root.filter-favorite=!root.filter-favorite;root.limit=50;root.search();}}
            Button {accessible-label:"PDFありだけ表示";text:"PDFあり";primary:root.filter-pdf;enabled:root.operable;clicked=>{root.filter-pdf=!root.filter-pdf;root.limit=50;root.search();}}
            Rectangle {horizontal-stretch:1;}
        }
        CheckBox {enabled:root.operable && !root.show-deleted;text:"アーカイブを含める";checked<=>root.include-archived;toggled=>{root.limit=50;root.search();}}
        ComboBox {enabled:root.operable;model:["追加日の新しい順","タイトル順","出版年の新しい順"];current-index<=>root.sort-index;selected(index)=>{root.limit=50;root.search();}}
        scroll := ScrollView {
            // Continuous scrolling: nearing the end asks for the next batch.
            changed content-y => { root.maybe-load-more(); }
            changed height => { root.maybe-load-more(); }
            vertical-stretch:1;
            VerticalBox {
                spacing:8px;alignment:start;
                for row in root.papers : PaperCard {
                    title: row.title;
                    authors: row.authors;
                    year: row.year;
                    citation-key: row.citation-key;
                    reading-status: row.reading-status;
                    favorite: row.favorite;
                    has-pdf: row.has-pdf;

                    active: root.editing-id == row.id;
                    selected: row.selected;
                    operable: root.operable;
                    export-mode: root.export-settings-open;

                    opened => {root.opened(row.id);}
                    selection-changed(checked) => {root.select-paper(row.id, checked);}
                }
                if root.papers.length==0 : Text {text:root.search-text!="" ? "一致する文献がありません。検索語を変えてください。" : (root.show-deleted ? "削除済みの文献はありません。" : "文献がまだありません。左のメニューから登録しましょう。");wrap:word-wrap;color:Theme.text-secondary;}
            }
        }
    }
}
