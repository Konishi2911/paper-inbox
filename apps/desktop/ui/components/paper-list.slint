import { VerticalBox, HorizontalBox, Button, LineEdit, TextEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";
import { PaperCard } from "paper-card.slint";
import { Theme } from "../theme.slint";
import { PaperRow } from "../types.slint";

export component PaperList inherits Rectangle {
    in property <string> editing-id;
    in property <bool> export-settings-open;
    in-out property <bool> include-archived;
    in-out property <int> offset;
    callback opened(string);
    in property <bool> operable;
    in property <[PaperRow]> papers;
    callback search();
    in-out property <string> search-text;
    callback select-paper(string,bool);
    in property <bool> show-deleted;
    in-out property <int> sort-index;
    in property <int> total;

    background: Theme.list-background;
    VerticalBox {
        padding:16px;spacing:10px;
        Text {text:root.show-deleted ? "削除済み" : "すべての文献";font-size:20px;font-weight:700;color:Theme.text-primary;}
        HorizontalBox {
            LineEdit {accessible-label:"文献を検索";enabled:root.operable;text<=>root.search-text;placeholder-text:"タイトル・著者・引用キーを検索";accepted=>{root.offset=0;root.search();}}
            Button {enabled:root.operable;text:"検索";clicked=>{root.offset=0;root.search();}}
        }
        CheckBox {enabled:root.operable && !root.show-deleted;text:"アーカイブを含める";checked<=>root.include-archived;toggled=>{root.offset=0;root.search();}}
        ComboBox {enabled:root.operable;model:["追加日の新しい順","タイトル順","出版年の新しい順"];current-index<=>root.sort-index;selected(index)=>{root.offset=0;root.search();}}
        ScrollView {
            vertical-stretch:1;
            VerticalBox {
                spacing:8px;alignment:start;
                for row in root.papers : PaperCard {
                    title: row.title;
                    authors: row.authors;
                    year: row.year;
                    citation-key: row.citation-key;

                    active: root.editing-id == row.id;
                    selected: row.selected;
                    operable: root.operable;
                    export-mode: root.export-settings-open;

                    opened => {root.opened(row.id);}
                    selection-changed(checked) => {root.select-paper(row.id, checked);}
                }
                if root.papers.length==0 : Text {text:root.search-text!="" ? "一致する文献がありません。検索語を変えてください。" : (root.show-deleted ? "削除済みの文献はありません。" : "文献がまだありません。左のメニューから登録しましょう。");wrap:word-wrap;color:Theme.text-secondary;}
            }
        }
        HorizontalBox {
            Button {text:"前へ";enabled:root.operable && root.offset>0;clicked=>{root.offset=max(0,root.offset - 20);root.search();}}
            Text {text:root.total==0 ? "0件" : (root.offset+1)+"–"+min(root.offset+20,root.total)+" / "+root.total;horizontal-alignment:center;}
            Button {text:"次へ";enabled:root.operable && root.offset+20<root.total;clicked=>{root.offset+=20;root.search();}}
        }
    }
}
