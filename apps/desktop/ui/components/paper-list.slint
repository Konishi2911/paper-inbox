import { VerticalBox, HorizontalBox, LineEdit, TextEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";
import { PaperCard } from "paper-card.slint";
import { Theme } from "../theme.slint";
import { PaperRow } from "../types.slint";
import { AppButton, Chip } from "app-button.slint";

export component PaperList inherits Rectangle {
    in property <string> editing-id;
    in property <bool> export-settings-open;
    in-out property <bool> include-archived;
    in-out property <bool> filter-unread;
    in-out property <bool> filter-favorite;
    in-out property <bool> filter-pdf;
    in-out property <int> limit: 50;
    callback load-more();
    callback opened(string);
    in property <bool> operable;
    in property <[PaperRow]> papers;
    callback search();
    in-out property <string> search-text;
    callback select-paper(string,bool);
    // Selection. The parent owns the selected ids; the rows only show them.
    in property <int> selected-count;
    // A Ctrl/Cmd and/or Shift click on a row: (id, ctrl, shift).
    callback row-modified-click(string,bool,bool);
    callback select-all();
    callback clear-selection();
    callback bulk-reading-status(int);
    callback bulk-favorite(bool);
    callback bulk-archive(bool);
    callback bulk-tag(string);
    callback bulk-bibtex();
    callback bulk-delete(bool);
    // Asked once before a bulk delete runs; cleared when the selection changes.
    private property <bool> confirm-bulk-delete: false;
    changed selected-count => { root.confirm-bulk-delete = false; }
    in property <bool> show-deleted;
    in-out property <int> sort-index;
    in property <int> total;

    pure function more-wanted() -> bool {
        return root.operable && root.papers.length < root.total && root.papers.length >= root.limit
            && scroll.content-y + scroll.content-height - scroll.height < 120px;
    }
    function maybe-load-more() {
        if (root.more-wanted()) { root.load-more(); }
    }

    // Typing searches by itself shortly after the last keystroke; Enter and the button search at once.
    typing := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.limit = 50;
            root.search();
        }
    }

    background: Theme.list-background;
    VerticalBox {
        padding:16px;spacing:10px;
        HorizontalBox {
            padding:0px;spacing:8px;
            Text {text:root.show-deleted ? "削除済み" : "すべての文献";font-size:20px;font-weight:700;color:Theme.text-primary;vertical-alignment:center;}
            Text {text:root.total==root.papers.length ? root.total+"件" : root.papers.length+" / "+root.total+"件";color:Theme.text-secondary;vertical-alignment:center;}
            Rectangle {horizontal-stretch:1;}
            ComboBox {accessible-label:"並び順";width:150px;enabled:root.operable;model:["追加日の新しい順","タイトル順","出版年の新しい順"];current-index<=>root.sort-index;selected(index)=>{root.limit=50;root.search();}}
        }
        HorizontalBox {
            padding:0px;spacing:8px;
            LineEdit {accessible-label:"文献を検索";text<=>root.search-text;placeholder-text:"タイトル・著者・引用キーを検索";accepted=>{typing.running=false;root.limit=50;root.search();} edited=>{typing.running=false;typing.running=true;}}
            AppButton {enabled:root.operable;text:"検索";clicked=>{root.limit=50;root.search();}}
        }
        HorizontalBox {
            padding:0px;spacing:6px;
            Chip {accessible-label:"未読だけ表示";text:"未読";on:root.filter-unread;enabled:root.operable;clicked=>{root.filter-unread=!root.filter-unread;root.limit=50;root.search();}}
            Chip {accessible-label:"お気に入りだけ表示";text:"★ お気に入り";on:root.filter-favorite;enabled:root.operable;clicked=>{root.filter-favorite=!root.filter-favorite;root.limit=50;root.search();}}
            Chip {accessible-label:"PDFありだけ表示";text:"PDFあり";on:root.filter-pdf;enabled:root.operable;clicked=>{root.filter-pdf=!root.filter-pdf;root.limit=50;root.search();}}
            Chip {accessible-label:"アーカイブを含める";text:"アーカイブ";on:root.include-archived;enabled:root.operable && !root.show-deleted;clicked=>{root.include-archived=!root.include-archived;root.limit=50;root.search();}}
            Rectangle {horizontal-stretch:1;}
        }
        // Shown while papers are selected: what is selected, and what can be done to all of it.
        if root.selected-count > 0 : Rectangle {
            background:Theme.surface;border-radius:8px;border-width:1px;border-color:Theme.selection-border;
            VerticalBox {
                padding:8px;spacing:6px;
                HorizontalLayout {
                    spacing:8px;
                    Text {text:root.selected-count+"件を選択中";font-weight:600;color:Theme.text-primary;vertical-alignment:center;horizontal-stretch:1;}
                    AppButton {small:true;kind:"ghost";enabled:root.operable;text:"選択を解除";clicked=>{root.clear-selection();}}
                }
                if !root.show-deleted : HorizontalLayout {
                    spacing:6px;
                    AppButton {small:true;enabled:root.operable;text:"未読";clicked=>{root.bulk-reading-status(0);}}
                    AppButton {small:true;enabled:root.operable;text:"読書中";clicked=>{root.bulk-reading-status(1);}}
                    AppButton {small:true;enabled:root.operable;text:"読了";clicked=>{root.bulk-reading-status(2);}}
                    AppButton {small:true;enabled:root.operable;text:"★ 付ける";clicked=>{root.bulk-favorite(true);}}
                    AppButton {small:true;enabled:root.operable;text:"★ 外す";clicked=>{root.bulk-favorite(false);}}
                    Rectangle {horizontal-stretch:1;}
                }
                if !root.show-deleted : HorizontalLayout {
                    spacing:6px;
                    AppButton {small:true;enabled:root.operable;text:"アーカイブ";clicked=>{root.bulk-archive(true);}}
                    AppButton {small:true;enabled:root.operable;text:"アーカイブ解除";clicked=>{root.bulk-archive(false);}}
                    AppButton {small:true;enabled:root.operable;text:"BibTeX";clicked=>{root.bulk-bibtex();}}
                    Rectangle {horizontal-stretch:1;}
                }
                if !root.show-deleted : LineEdit {
                    accessible-label:"選択した文献にタグを付ける";
                    placeholder-text:"選択した文献にタグを付ける（Enterで確定）";
                    enabled:root.operable;
                    accepted(text) => {
                        if (text != "") { root.bulk-tag(text); self.text = ""; }
                    }
                }
                if !root.confirm-bulk-delete : HorizontalLayout {
                    spacing:6px;
                    Rectangle {horizontal-stretch:1;}
                    if root.show-deleted : AppButton {small:true;enabled:root.operable;text:"選択した文献を復元";clicked=>{root.bulk-delete(false);}}
                    if !root.show-deleted : AppButton {small:true;kind:"danger";enabled:root.operable;text:"削除";clicked=>{root.confirm-bulk-delete = true;}}
                }
                if root.confirm-bulk-delete : HorizontalLayout {
                    spacing:6px;
                    Text {text:root.selected-count+"件を削除しますか？（削除済みから復元できます）";color:Theme.danger-text;vertical-alignment:center;wrap:word-wrap;horizontal-stretch:1;}
                    AppButton {small:true;kind:"danger";enabled:root.operable;text:"削除する";clicked=>{root.confirm-bulk-delete = false;root.bulk-delete(true);}}
                    AppButton {small:true;kind:"ghost";enabled:root.operable;text:"キャンセル";clicked=>{root.confirm-bulk-delete = false;}}
                }
            }
        }
        list-keys := FocusScope {
            vertical-stretch:1;
            // Ctrl+A (Cmd+A) selects every row shown; Escape drops the selection. Other keys,
            // and typing in the search box, are not taken.
            key-pressed(event) => {
                if ((event.modifiers.control || event.modifiers.meta) && root.operable
                    && (event.text == "a" || event.text == "A" || event.text == "\u{1}")) {
                    root.select-all();
                    return accept;
                }
                if (event.text == Key.Escape && root.selected-count > 0) {
                    root.clear-selection();
                    return accept;
                }
                return reject;
            }
        scroll := ScrollView {
            // Continuous scrolling: nearing the end asks for the next batch.
            changed content-y => { root.maybe-load-more(); }
            changed height => { root.maybe-load-more(); }
            vertical-stretch:1;
            VerticalBox {
                spacing:8px;alignment:start;
                for row in root.papers : PaperCard {
                    title: row.title;
                    authors: row.authors;
                    year: row.year;
                    citation-key: row.citation-key;
                    reading-status: row.reading-status;
                    favorite: row.favorite;
                    has-pdf: row.has-pdf;

                    active: root.editing-id == row.id;
                    selected: row.selected;
                    operable: root.operable;
                    export-mode: root.export-settings-open;

                    opened => {list-keys.focus();root.opened(row.id);}
                    modified-click(ctrl, shift) => {list-keys.focus();root.row-modified-click(row.id, ctrl, shift);}
                    selection-changed(checked) => {root.select-paper(row.id, checked);}
                }
                if root.papers.length==0 : Text {text:root.search-text!="" ? "一致する文献がありません。検索語を変えてください。" : (root.show-deleted ? "削除済みの文献はありません。" : "文献がまだありません。左のメニューから登録しましょう。");wrap:word-wrap;color:Theme.text-secondary;}
            }
        }
        }
    }
}
