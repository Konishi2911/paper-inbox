import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AttachmentRow } from "../types.slint";
import { Theme } from "../theme.slint";
import { AppButton } from "app-button.slint";

// PDFs of the paper on screen. Opening is the main action; removing asks once in the row
// itself because the file is only reclaimed later by the explicit cleanup.
export component AttachmentList inherits VerticalBox {
    in property <[AttachmentRow]> rows;
    in property <bool> operable: true;
    callback attach-requested();
    callback open-requested(string);
    callback detach-requested(string);

    // Row waiting for the removal confirmation; empty when none.
    private property <string> confirming;

    padding: 0px;
    spacing: 6px;

    HorizontalBox {
        padding: 0px;
        spacing: 8px;
        Text {
            text: "PDF";
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            color: Theme.text-primary;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        AppButton {
            text: "追加…";
            enabled: root.operable;
            clicked => {
                root.confirming = "";
                root.attach-requested();
            }
        }
    }
    for row in root.rows : Rectangle {
        background: Theme.background;
        border-radius: 6px;
        min-height: line.preferred-height;
        line := HorizontalBox {
            padding: 8px;
            spacing: 8px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                min-width: 0px;
                Text {
                    text: row.name;
                    font-weight: 600;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                    min-width: 0px;
                }
                Text {
                    text: row.details;
                    color: row.missing ? Theme.warning : Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                    min-width: 0px;
                }
            }
            if root.confirming != row.id : AppButton {
                accessible-label: row.name + "を開く";
                text: "開く";
                primary: true;
                enabled: root.operable && !row.missing;
                clicked => {
                    root.open-requested(row.id);
                }
            }
            if root.confirming != row.id : AppButton {
                accessible-label: row.name + "を除外";
                text: "除外";
                kind: "danger";
                enabled: root.operable;
                clicked => {
                    root.confirming = row.id;
                }
            }
            if root.confirming == row.id : Text {
                text: "除外しますか？";
                vertical-alignment: center;
                color: Theme.warning;
            }
            if root.confirming == row.id : AppButton {
                accessible-label: row.name + "の除外を実行";
                text: "除外";
                kind: "danger";
                enabled: root.operable;
                clicked => {
                    root.confirming = "";
                    root.detach-requested(row.id);
                }
            }
            if root.confirming == row.id : AppButton {
                accessible-label: row.name + "の除外をやめる";
                text: "キャンセル";
                kind: "outline";
                clicked => {
                    root.confirming = "";
                }
            }
        }
    }
}
