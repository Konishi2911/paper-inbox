import { VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppButton } from "../components/app-button.slint";

// Asks for the new name of a tag. The dialog stays open while a name is refused, and shows why.
export component TagRenameDialog inherits FocusScope {
    in-out property <string> text;
    in property <string> error;
    in property <string> old-name;
    callback submitted(string);
    callback cancelled();
    width: 420px;
    height: 220px;
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            root.cancelled();
            return accept;
        }
        return reject;
    }
    Rectangle {
        background: Theme.surface;
        border-radius: 12px;
        VerticalBox {
            padding: 24px;
            spacing: 12px;
            Text {
                text: "タグ名を変更";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text {
                text: "「" + root.old-name + "」の新しい名前を入力してください。";
                wrap: word-wrap;
                color: Theme.text-secondary;
            }
            name-edit := LineEdit {
                accessible-label: "新しいタグ名";
                text <=> root.text;
                init => { self.focus(); }
                accepted(value) => { root.submitted(value); }
            }
            Text {
                text: root.error;
                wrap: word-wrap;
                color: Theme.danger-text;
                min-height: 18px;
            }
            HorizontalBox {
                padding: 0px;
                alignment: end;
                AppButton {
                    kind: "outline";
                    text: "キャンセル";
                    clicked => { root.cancelled(); }
                }
                AppButton {
                    text: "変更";
                    clicked => { root.submitted(root.text); }
                }
            }
        }
    }
}
